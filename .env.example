# =========================================================================
# Digital Logic Simulation Suite — Environment Configuration Example
# Copy this file to '.env' and populate your production secrets.
# =========================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Server Port (default 8000)
PORT=8000

# Security: JWT Secret Key
# Generate a strong 256-bit random key in terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_strong_production_secret_key_32_bytes_or_more

# Database Connection:
# - Local Dev: Leave empty or unset to automatically use local SQLite ('backend/users.db')
# - Production Cloud: Paste your PostgreSQL connection URL from Neon, Supabase, or Render:
#   Example: postgresql://username:password@ep-cool-project-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Allowed CORS Origins (comma-separated list of allowed frontend URLs)
# In development, '*' allows all local origins.
# In production, specify your Vercel domains:
# Example: https://logic-sim-suite.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*
